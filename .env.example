# Secret HMAC key used for deterministic replacement across runs and FK tables.
# Replace this with a strong random secret in production.
PII_SHIELD_SALT=change-me-to-a-32-byte-secret-salt

# Default anonymization mode: "synthetic" or "redact"
PII_SHIELD_MODE=synthetic

# Enforce strict offline air-gapped operation (disables any external model downloads)
PII_SHIELD_AIRGAP_STRICT=true

# Minimum confidence threshold (0.0 - 1.0) for Presidio / regex detections
PII_SHIELD_SCORE_THRESHOLD=0.4

# Local Faker locale (e.g., en_IN, en_US)
PII_SHIELD_LOCALE=en_IN

# Optional spaCy model name pre-installed in the image/environment
PII_SHIELD_SPACY_MODEL=en_core_web_sm

# Optional API server settings
PII_SHIELD_HOST=0.0.0.0
PII_SHIELD_PORT=8080

# Optional local metadata-only audit log path (never logs raw PII)
# PII_SHIELD_AUDIT_LOG_PATH=./audit/pii_shield_audit.jsonl
